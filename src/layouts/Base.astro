---
import "@/index.css";
import { absoluteUrl, alternatePath, locales, normalizePath, pagePath, type Locale } from "@/i18n/routes";
import { organizationGraph, ogImage } from "@/lib/seo";
import { useTranslations } from "@/i18n/ui";
import Navbar from "@/components/layout/Navbar.astro";
import Updates from "@/components/layout/Updates.astro";
import Footer from "@/components/layout/Footer.astro";

/** Every page: head tags, navbar, the page itself, the updates sign-up, and the footer. */
interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** This page's path, without a trailing slash ("/" for the home page). */
  path: string;
  type?: "website" | "article";
  /** Extra JSON-LD for this page (the Organization graph is on every page). */
  jsonLd?: object[];
  /** Not-found pages: noindex, no language alternates, canonical to home. */
  notFound?: boolean;
  /**
   * The languages this page exists in (default: both). A blog post written in
   * one language only gets no hreflang for the other, and its language link
   * goes to that language's blog instead.
   */
  translations?: Locale[];
}

const { lang, title, description, type = "website", jsonLd = [], notFound = false, translations = locales } = Astro.props;
const t = useTranslations(lang);
const path = normalizePath(Astro.props.path);
const canonical = absoluteUrl(notFound ? alternatePath("/", lang) : path);
const exists = (l: Locale) => !notFound && translations.includes(l);
// This page in each language, for the ID / EN links; a missing translation links to that language's blog.
const languages = locales.map((l) => ({
  lang: l,
  href: exists(l) ? alternatePath(path, l) : notFound ? pagePath("home", l) : pagePath("blog", l),
}));
const hreflangs = languages.filter((l) => exists(l.lang));
const xDefault = hreflangs.find((l) => l.lang === "id") ?? hreflangs[0];
const image = ogImage(lang);
const imageAlt = t("meta.ogImageAlt");
const ldJson = (data: object) => JSON.stringify(data).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Livales" />
    <meta name="robots" content={notFound ? "noindex" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={canonical} />
    {
      hreflangs.length > 1 && (
        <>
          {hreflangs.map((l) => (
            <link rel="alternate" hreflang={l.lang} href={absoluteUrl(l.href)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefault.href)} />
        </>
      )
    }

    <!-- Google Search needs a square icon of at least 48x48 (multiples of 48). -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Livales" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={lang === "id" ? "id_ID" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "id" ? "en_US" : "id_ID"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Structured data: the company, its logo, profiles and apps; plus this page's own -->
    <script type="application/ld+json" set:html={ldJson(organizationGraph)} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={ldJson(data)} />)}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Unbounded:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="min-h-screen overflow-x-clip">
      <Navbar lang={lang} path={path} languages={languages} />
      <main>
        <slot />
      </main>
      <Updates lang={lang} />
      <Footer lang={lang} />
    </div>
  </body>
</html>
