---
import { cn } from "@/lib/utils";

/** The top of an inner page: its h1 and a short lead, with an optional picture beside it (the `aside` slot). */
interface Props {
  title: string;
  lead: string;
  /** Give the picture a wider column (for the product previews). */
  wideAside?: boolean;
}

const { title, lead, wideAside = false } = Astro.props;
---

<header
  class={cn(
    "page grid items-end gap-10 pb-16 pt-12 sm:pb-20 sm:pt-16 lg:gap-20 lg:pt-24",
    wideAside ? "lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)]" : "lg:grid-cols-[minmax(0,1fr)_minmax(0,16rem)]"
  )}
>
  <div>
    <h1 class="heading-xl max-w-[16ch]">{title}</h1>
    <p class="prose-copy mt-7 text-ink/80">{lead}</p>
  </div>
  <slot name="aside" />
</header>
