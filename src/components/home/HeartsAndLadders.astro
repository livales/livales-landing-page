---
import { useTranslations, HL_URL, HL_TESTER_URL } from "@/i18n/ui";
import type { Locale } from "@/i18n/routes";
import PhoneShot from "@/components/PhoneShot.astro";
import TextLink from "@/components/TextLink.astro";
import ProductMark from "@/components/brand/ProductMark.astro";

/**
 * Soft rose field right after the hero: Hearts & Ladders, the app for couples,
 * is in Android testing and looking for early testers (sign-up happens on its
 * own site). Screenshots are real, copied from its site.
 */
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const points = ["point1", "point2", "point3"];
---

<section class="overflow-hidden bg-livales-rose-soft">
  <div class="page grid gap-14 py-20 sm:py-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,27rem)] lg:items-center lg:gap-16">
    <div>
      <div class="flex items-center gap-4">
        <ProductMark product="hl" class="h-14 w-14" />
        <span class="rounded-full bg-white px-4 py-1.5 text-[0.95rem] font-semibold">
          {t("product.hl.status")}
        </span>
      </div>
      <h2 class="heading-lg mt-8 max-w-[20ch]">{t("hl.title")}</h2>
      <p class="prose-copy mt-6 text-ink/80">{t("hl.body")}</p>
      <ul class="mt-8 max-w-[34rem] space-y-3 text-[1.05rem]">
        {
          points.map((p) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="mt-[0.55rem] h-2.5 w-2.5 shrink-0 rounded-full bg-livales-rose" />
              {t(`hl.${p}`)}
            </li>
          ))
        }
      </ul>
      <div class="mt-10 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-8">
        <a href={HL_TESTER_URL[lang]} target="_blank" rel="noopener noreferrer" class="btn-ink">
          {t("product.hl.tester")}
          <span class="sr-only"> {t("common.newTab")}</span>
        </a>{" "}
        <TextLink href={HL_URL[lang]} newTabLabel={t("common.newTab")}>
          {t("product.hl.cta")}
        </TextLink>
      </div>
    </div>

    <!-- Two screens, the second a step lower: a pair, side by side. -->
    <div class="mx-auto grid w-full max-w-[24rem] grid-cols-2 gap-4 sm:gap-5 lg:max-w-none">
      <PhoneShot src={`/products/hearts-and-ladders/board-${lang}.webp`} alt={t("hl.shot.board")} />
      <PhoneShot src={`/products/hearts-and-ladders/challenge-${lang}.webp`} alt={t("hl.shot.challenge")} class="mt-12" />
    </div>
  </div>
</section>
