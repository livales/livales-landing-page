---
import { useTranslations } from "@/i18n/ui";
import type { Locale } from "@/i18n/routes";
import FaqList from "@/components/islands/Faq";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = ["1", "2", "3", "4", "5"].map((n) => ({ q: t(`faq.q${n}`), a: t(`faq.a${n}`) }));
---

<section id="faq">
  <div class="page grid gap-10 py-20 sm:py-28 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-20">
    <h2 class="heading-lg">{t("faq.title")}</h2>
    <FaqList client:visible items={items} />
  </div>
</section>
