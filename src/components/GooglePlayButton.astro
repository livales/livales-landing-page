---
import { useTranslations, HL_PLAY_URL } from "@/i18n/ui";
import type { Locale } from "@/i18n/routes";
import { cn } from "@/lib/utils";

/** The ink button to Hearts & Ladders on Google Play, with the Play mark in one flat colour. */
interface Props {
  lang: Locale;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);
---

<a href={HL_PLAY_URL[lang]} target="_blank" rel="noopener noreferrer" class={cn("btn-ink gap-2.5 whitespace-nowrap", className)}>
  <svg viewBox="0 0 24 24" aria-hidden="true" class="h-[1.1em] w-[1.1em] shrink-0" fill="currentColor">
    <path
      d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z"
    ></path>
  </svg>
  {t("product.hl.play")}
  <span class="sr-only"> {t("common.newTab")}</span>
</a>
