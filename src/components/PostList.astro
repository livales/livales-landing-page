---
import { useTranslations } from "@/i18n/ui";
import { postPath, type Locale } from "@/i18n/routes";
import { formatDate, type Post } from "@/lib/posts";
import { cn } from "@/lib/utils";

/** Articles as a plain list: date and reading time, the title, and its summary. */
interface Props {
  lang: Locale;
  posts: Post[];
  compact?: boolean;
}

const { lang, posts, compact = false } = Astro.props;
const t = useTranslations(lang);
---

<ul class="border-t border-ink/15">
  {
    posts.map((post) => (
      <li class="border-b border-ink/15">
        <a href={postPath(post.slug, lang)} class={cn("group block", compact ? "py-7" : "py-9")}>
          <span class="flex flex-wrap gap-x-5 gap-y-1 text-[0.95rem] text-ink/65">
            <time datetime={post.isoDate}>{formatDate(post.isoDate, lang)}</time>{" "}
            <span>
              {post.data.readMinutes} {t("blog.readTime")}
            </span>
          </span>{" "}
          <span
            class={cn(
              "mt-3 block max-w-[34ch] font-display font-semibold leading-snug tracking-[-0.01em] decoration-livales-rose decoration-[3px] underline-offset-[6px] group-hover:underline",
              compact ? "text-[1.2rem] sm:text-[1.35rem]" : "text-[1.35rem] sm:text-[1.7rem]"
            )}
          >
            {post.data.title}
          </span>{" "}
          {!compact && (
            <span class="mt-3 block max-w-[40rem] text-[1.05rem] leading-relaxed text-ink/75">{post.data.description}</span>
          )}
        </a>
      </li>
    ))
  }
</ul>
