---
import { getPosts, type Post } from "@/lib/posts";
import BlogPost from "@/views/BlogPost.astro";

export async function getStaticPaths() {
  return (await getPosts("en")).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
---

<BlogPost lang="en" post={post} />
